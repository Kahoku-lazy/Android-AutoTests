# Android-AutoTests 环境变量配置
# 复制此文件为 .env 并根据实际情况修改
# cp .env.example .env

# Django
# # 生成key：python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True

# 允许访问的 Host（逗号分隔）。留空 = 按环境默认：
#   开发（DJANGO_DEBUG=True）→ "*"；生产 → "127.0.0.1,localhost"
# 对外提供服务时请设为实际域名/IP，例如：
# DJANGO_ALLOWED_HOSTS=example.com,api.example.com

# 跨域来源白名单（逗号分隔）。生产默认不放行任何跨域来源，按需填写：
# CORS_ALLOWED_ORIGINS=https://example.com
# 如需在生产放开全部来源（不推荐，且默认已关闭）：
# CORS_ALLOW_ALL_ORIGINS=True

# 安全加固（默认全部关闭 / 由 DEBUG 决定 —— 不会改变现有 HTTP 部署的行为）
# HSTS：确认全站 HTTPS 后再设置，例如 31536000（1 年）；建议先设小值验证
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# HTTPS 跳转：只有「Django 直接终止 TLS」时才开启；
# 反向代理已终止 TLS 时开启会导致 301 循环
# SECURE_SSL_REDIRECT=True
# 反向代理场景：信任 X-Forwarded-Proto，让 Django 还原原始协议
# SECURE_PROXY_SSL_HEADER=True
# Cookie 安全标志：生产（DEBUG=False）默认已为 True，一般无需显式设置
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# 设备配置
DEVICE_SERIAL=your-device-serial
# 容器内连接宿主机 ADB daemon 时填写（adb 与 uiautomator2 原生读取该环境变量）：
# ANDROID_ADB_SERVER_ADDRESS=host.docker.internal:5037
# 本地开发端口（Docker 部署用 8765，本地默认 8766，避免冲突）
SERVER_PORT=8766

# 数据根目录（上传/截图/向量库/知识库文档等落盘的统一根）
# 留空 = 项目内 data/；可指向外部盘/卷（绝对路径直用，相对路径按项目根解析）
# DATA_DIR=D:\Govee\data

# 引擎插槽（唯二的可替换引擎开关；换实现只改这两行）
# DEVICE_ENGINE=u2        # 设备引擎（默认 u2）—— 白名单键见 engines/device/registry.py
# AI_ENGINE=agentscope    # AI 引擎（默认 agentscope）—— 见 engines/ai/registry.py

# MySQL 数据库
DB_ENGINE=mysql
DB_NAME=android_autotests
DB_USER=root
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# 整串覆盖：优先于 HOST/PORT（Channels 层与 JWT 黑名单共用）
# REDIS_URL=redis://localhost:6379/0

# 知识库 RAG 嵌入模型（三选一）
# 方案一：阿里云 DashScope（中文效果好，推荐）
# EMBEDDING_PROVIDER=dashscope
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_API_KEY=your-dashscope-api-key
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_DIMENSIONS=1024
# 方案二：Ollama 本地（无需 API key）
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_DIMENSIONS=1024
# 方案三：OpenAI 兼容 API
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=your-api-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_DIMENSIONS=1536

# 日志
# 级别（DEBUG / INFO / WARNING / ERROR），默认 INFO
# LOG_LEVEL=INFO
# 容器环境：只输出 stdout（由编排收集），不写 logs/django.log；本地默认两者都有
# DOCKER_CONTAINER=false

# JWT
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# 工具网关内部令牌（/api/ai/tools/* 免 JWT，改用请求头 X-Internal-Token 校验）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 留空 = 该前缀一律 401（fail-closed），不要在未配置时放开
AI_TOOL_GATEWAY_TOKEN=

# Admin（登录用户名密码在 Django DB 中，非环境变量）
# 首次运行通过 python manage.py createsuperuser 创建

# 设备管理管理员白名单（逗号分隔用户名）：命中者全局可见所有设备（含锁定）
# ADMIN_USERS=admin,ops

# 维护：聊天上传临时文件清理（cleanup_uploads 管理命令；默认保留 7 天）
# UPLOAD_CLEANUP_MAX_AGE_DAYS=7
