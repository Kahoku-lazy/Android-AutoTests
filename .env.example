# Android-AutoTests 环境变量配置
# 复制此文件为 .env 并根据实际情况修改
# cp .env.example .env

# Django
# # 生成key：python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True

# 设备配置
DEVICE_SERIAL=your-device-serial
SCREENSHOT_INTERVAL=0.5
# 本地开发端口（Docker 部署用 8765，本地默认 8766，避免冲突）
SERVER_PORT=8766

# MySQL 数据库
DB_ENGINE=mysql
DB_NAME=android_autotests
DB_USER=root
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AgentScope（Django 进程内运行，非独立服务；此端口用于内部进程间通信配置）
AGENTSCOPE_PORT=8000

# 知识库 RAG 嵌入模型（三选一）
# 方案一：阿里云 DashScope（中文效果好，推荐）
# EMBEDDING_PROVIDER=dashscope
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_API_KEY=your-dashscope-api-key
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_DIMENSIONS=1024
# 方案二：Ollama 本地（无需 API key）
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_DIMENSIONS=1024
# 方案三：OpenAI 兼容 API
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=your-api-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_DIMENSIONS=1536

# JWT
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# Admin（登录用户名密码在 Django DB 中，非环境变量）
# 首次运行通过 python manage.py createsuperuser 创建
