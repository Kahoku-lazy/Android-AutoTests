# Android-AutoTests 环境变量配置
# 复制此文件为 .env 并根据实际情况修改

# Django
DJANGO_SECRET_KEY=change-this-to-a-random-string
DJANGO_DEBUG=True

# 设备配置
DEVICE_SERIAL=your-device-serial
SCREENSHOT_INTERVAL=0.5
SERVER_PORT=8765

# MySQL 数据库
DB_NAME=android_autotests
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis (生产环境使用，开发环境使用内存通道层)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
