# Android-AutoTests 环境变量配置
# 复制此文件为 .env 并根据实际情况修改
# cp .env.example .env
# UTF-8：emoji（📝 / ✅ / 🔴/❌）

# Django
# # 生成key：python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True

# 设备配置
DEVICE_SERIAL=your-device-serial
# 容器内连接宿主机 ADB daemon 时填写（adb 与 uiautomator2 原生读取该环境变量）：
# ANDROID_ADB_SERVER_ADDRESS=host.docker.internal:5037
# 本地开发端口（Docker 部署用 8765，本地默认 8766，避免冲突）
SERVER_PORT=8766

# MySQL 数据库
DB_ENGINE=mysql
DB_NAME=android_autotests
DB_USER=root
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379


# JWT
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# 工具网关内部令牌（/api/ai/tools/* 免 JWT，改用请求头 X-Internal-Token 校验）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 留空 = 该前缀一律 401（fail-closed），不要在未配置时放开
AI_TOOL_GATEWAY_TOKEN=

# ── 知识库助手（实时语音）──
# 阿里百炼 DashScope API Key；知识库助手实时语音复用该 Key
DASHSCOPE_API_KEY=
# 未配置 Key 时页面显示「未就绪」，不影响其它模块
KNOWLEDGE_ASSISTANT_ENABLED=true
# 调用方式：omni（实时对话，默认）| livetranslate（实时翻译，更便宜）
KNOWLEDGE_ASSISTANT_REALTIME_MODE=omni
KNOWLEDGE_ASSISTANT_MODEL=qwen3.5-omni-plus-realtime
# 实时翻译目标语种：zh / en / ja ...（仅 livetranslate 模式生效）
# KNOWLEDGE_ASSISTANT_TRANSLATION_LANGUAGE=zh
KNOWLEDGE_ASSISTANT_VOICE=Tina
# 以下 VAD 参数仅 omni 模式生效
# server_vad / semantic_vad（本助手不启用本地 VAD）
KNOWLEDGE_ASSISTANT_TURN_DETECTION=server_vad
# 服务端 VAD 阈值（0.0-1.0，越低越容易触发）与判定说完的静音毫秒数（200-3000）
KNOWLEDGE_ASSISTANT_VAD_THRESHOLD=0.35
KNOWLEDGE_ASSISTANT_VAD_SILENCE_MS=700
# 需要低成本实时翻译时改用下面两项：
# KNOWLEDGE_ASSISTANT_REALTIME_MODE=livetranslate
# KNOWLEDGE_ASSISTANT_MODEL=qwen3.8-livetranslate-flash-realtime
# KNOWLEDGE_ASSISTANT_TRANSLATION_LANGUAGE=zh
# Pipeline 路线（ASR + DeepSeek Flash + TTS）需要 DeepSeek Key；前端按会话选择
DEEPSEEK_API_KEY=
# TTS 厂商：sambert（默认，中文知厨）/ qwen
# KNOWLEDGE_ASSISTANT_PIPELINE_TTS_PROVIDER=sambert
# KNOWLEDGE_ASSISTANT_PIPELINE_TTS_MODEL=sambert-zhichu-v1
# KNOWLEDGE_ASSISTANT_PIPELINE_TTS_VOICE=知厨
# Pipeline 回答链路：agent（默认，Agent + 中间件）/ legacy（直连模型 + 单独合成）
# KNOWLEDGE_ASSISTANT_PIPELINE_ENGINE=agent
# 如需切回 Qwen-TTS：
# KNOWLEDGE_ASSISTANT_PIPELINE_TTS_PROVIDER=qwen
# KNOWLEDGE_ASSISTANT_PIPELINE_TTS_MODEL=qwen3-tts-flash
# KNOWLEDGE_ASSISTANT_PIPELINE_TTS_VOICE=Cherry
# 说明：qwen3.8-livetranslate 输入仅 Audio/Image，不能接收文本做 TTS；
# Pipeline 的播报使用 Sambert 或 Qwen-TTS。
# RAG：Pipeline 的 DeepSeek 检索增强；索引写在 data/rag_index，不修改资料目录
# KNOWLEDGE_ASSISTANT_RAG_ENABLED=true
# KNOWLEDGE_ASSISTANT_RAG_DATA_DIR=D:\Govee\data\rag_data
# KNOWLEDGE_ASSISTANT_RAG_INDEX_DIR=data/rag_index
# KNOWLEDGE_ASSISTANT_RAG_TOP_K=4
# KNOWLEDGE_ASSISTANT_RAG_SCORE_THRESHOLD=0.55
# 嵌入模型默认复用 DASHSCOPE_API_KEY
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_ASSISTANT_AGENT_NAME=知识库助手
# 对话日志目录；相对路径按仓库根目录解析，默认 logs/knowledge_assistant
# KNOWLEDGE_ASSISTANT_LOG_DIR=logs/knowledge_assistant
# 可选：覆盖内置系统提示词（一般不需要）
# KNOWLEDGE_ASSISTANT_SYSTEM_PROMPT=

# ── 模型调用重试与回退（引擎中间件 engines/agents/middleware）──
# 同一个模型最多调用几次（含第一次）；1 = 不重试。模型层已自带 3 次重试，
# 这里只补一层「退避更久」的尝试，默认 2 即总共调用两次。
# AGENT_MODEL_RETRY_ATTEMPTS=2
# 首次重试前的等待毫秒数，之后按次数翻倍（800 → 1600 …）
# AGENT_MODEL_RETRY_BASE_DELAY_MS=800
# 单次等待的毫秒上限
# AGENT_MODEL_RETRY_MAX_DELAY_MS=8000
# 备用模型：默认留空 = 不启用回退；只在瞬态故障（429/5xx/超时）后接管。
# 成本口径：主模型固定用 FLASH；没有特殊要求不得配 PRO（含这里）。
# 确需临时回退到 PRO 时，先评估费用再写，用完复原。
# AGENT_FALLBACK_MODEL=
# 备用模型 provider / 地址 / 密钥；留空则沿用主模型的那一套
# AGENT_FALLBACK_PROVIDER=
# AGENT_FALLBACK_BASE_URL=
# AGENT_FALLBACK_API_KEY=

# ── 其余引擎中间件（装配顺序：追踪 → 预算 → RAG → 语音 → 记忆入口 → 重试）──
# 链路追踪：配了 OTLP/HTTP 端点才启用，例如 http://localhost:4318/v1/traces
# AGENT_TRACING_OTLP_ENDPOINT=
# AGENT_TRACING_SERVICE_NAME=android-autotests
# 单次回复的加权 token 上限（输入×权重 + 输出×权重）；0 = 关闭护栏。
# 默认 60 万是「失控护栏」而非成本控制：执行者一轮最多 60 次 ReAct，
# 正常长用例也可能累计到几十万；想按成本收紧就调小。
# AGENT_REPLY_TOKEN_BUDGET=600000
# AGENT_REPLY_INPUT_WEIGHT=1
# AGENT_REPLY_OUTPUT_WEIGHT=2
# RAG 上下文：开关打开后复用现有 rag 索引（索引本身由 KNOWLEDGE_ASSISTANT_RAG_* 决定）
# AGENT_RAG_ENABLED=false
# AGENT_RAG_TOP_K=0
# 语音合成中间件：默认关闭；打开需 DASHSCOPE_API_KEY
# AGENT_TTS_MIDDLEWARE=false
# AGENT_TTS_MODEL=qwen3-tts-flash
# AGENT_TTS_VOICE=Cherry
# 长期记忆：仅保留入口，当前配置也不会生效（会记一条警告）
# AGENT_MEMORY_BACKEND=

