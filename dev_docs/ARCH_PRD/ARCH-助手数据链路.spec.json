  "cards": [
    {
      "dot": "cyan",
      "title": "建卡只写一行",
      "items": [
        "ai_assistants：编号 YYYYMMDD_XXX、名称、头像 base64、笔色、role_id、工具勾选",
        "revision=1、release_state=draft；role_id 是字符串引用，不是外键",
        "头像压到 ≤12KB，笔色按上一张卡轮转 5 色（teal→ink→amber→rose→moss）"
      ]
    },
    {
      "dot": "emerald",
      "title": "发布才冻快照",
      "items": [
        "publish 把 role 的 system_prompt、工具与模型元数据写进 ai_assistant_releases",
        "对话在首次发送冻结快照；只有新建的对话栏才跟随提示词变化",
        "SOP 任务钉住发布版本；goal / team 跟随最新发布",
        "已发布再点发布会 400；只有改 role_id / tools 才回 draft"
      ]
    },
    {
      "dot": "amber",
      "title": "两条运行路径",
      "items": [
        "对话：首次发送冻 snapshot → 后台线程 + 专用事件循环 → reply_stream 流式消费",
        "任务：Task 记 release_version → run_bound_sop（执行者动手 + 验收者逐条判）",
        "两者都写 HTML 报告与 ai_usage_records；报告按助手/对话栏分目录"
      ]
    },
    {
      "dot": "rose",
      "title": "四处容易踩",
      "items": [
        "前端编辑从不发 revision，409 乐观锁实际未启用",
        "role_id 悬空时列表 role_name 为空串，删除 Agent 配置不会级联",
        "进程重启把遗留 running 改 interrupted（apps.py ready 里做）",
        "删除被工作流绑定的名片会被拦，并列出占用它的工作流名"
      ]
    }
  ]
