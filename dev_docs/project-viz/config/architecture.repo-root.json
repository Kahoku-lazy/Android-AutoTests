  "cards": [
    {
      "title": "三层分工",
      "items": [
        "frontend/ 只展示：任务、花费、能力与运行状态",
        "backend/ 只做通道与记账：鉴权、下发、落库",
        "engines/ 承载全部可执行能力，零 django 依赖"
      ]
    },
    {
      "title": "执行闭环",
      "items": [
        "submit → task_runner 装配角色与 SOP",
        "backend_bridge 造 Agent、挂工具、跑流程",
        "事件与用量回传 → 任务详情 / 报告 / 看板"
      ]
    },
    {
      "title": "当前边界",
      "items": [
        "无 WS 生产路由：进度走 HTTP 轮询",
        "engines 与 ASGI 同进程，只注入配置",
        "唯一写库口在各 App 的 api.py"
      ]
    }
  ]
