{
  "name": "android-autotests-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:styles": "node tests/check-style-gates.mjs",
    "depcruise": "dependency-cruiser src/",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:p0": "node tests/run.mjs prio p0",
    "test:p1": "node tests/run.mjs prio p1",
    "test:module": "node tests/run.mjs module",
    "test:report": "node tests/run.mjs all",
    "test:report:junit": "node tests/run.mjs junit",
    "test:report:json": "node tests/run.mjs json",
    "test:report:html": "node tests/run.mjs html",
    "test:verbose": "node tests/run.mjs verbose",
    "test:ui": "node tests/run.mjs ui"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "animejs": "^4.5.0",
    "axios": "^1.7.0",
    "dompurify": "^3.4.12",
    "echarts": "^5.5.0",
    "element-plus": "^2.7.0",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "mitt": "^3.0.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/ui": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.4",
    "typescript": "~5.4.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.12"
  }
}
