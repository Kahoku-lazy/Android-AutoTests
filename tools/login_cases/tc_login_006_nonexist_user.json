{
  "title": "[Web] 登录-不存在用户登录应报错",
  "url": "http://localhost:5173/login",
  "priority": "P0",
  "description": "验证使用不存在的用户名登录时，服务端返回「用户名或密码错误」（不泄露用户存在性）",
  "expected_result": "ElMessage 弹窗显示「用户名或密码错误」，与错误密码场景一致",
  "directory_id": 109,
  "steps": [
    {"type": "web_navigate", "url": "http://localhost:5173/login?add=1", "description": "打开登录页"},
    {"type": "web_wait", "timeout": 2, "description": "等待页面加载完成"},
    {"type": "web_fill", "selector": "input[placeholder=\"账号\"]", "value": "nonexistent_user_xyz_999", "description": "填入不存在的用户名"},
    {"type": "web_fill", "selector": "input[placeholder=\"密码\"]", "value": "somepassword", "description": "填入任意密码"},
    {"type": "web_click", "selector": "button.el-button--primary", "description": "点击登录按钮"},
    {"type": "web_wait", "timeout": 2, "description": "等待服务器响应"},
    {"type": "web_assert", "expected_text": "用户名或密码错误", "description": "验证返回通用错误（不区分用户存在性）"},
    {"type": "web_screenshot", "description": "不存在用户登录弹窗截图"}
  ]
}
