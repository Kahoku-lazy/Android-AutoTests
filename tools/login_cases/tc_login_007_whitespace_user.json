{
  "title": "[Web] 登录-纯空格用户名登录应报错",
  "url": "http://localhost:5173/login",
  "priority": "P1",
  "description": "验证用户名仅包含空格时，前端客户端校验拦截，弹窗提示「用户名不能为空白」",
  "expected_result": "ElMessage 弹窗显示「用户名不能为空白」",
  "directory_id": 109,
  "steps": [
    {"type": "web_navigate", "url": "http://localhost:5173/login?add=1", "description": "打开登录页"},
    {"type": "web_wait", "timeout": 2, "description": "等待页面加载完成"},
    {"type": "web_fill", "selector": "input[placeholder=\"账号\"]", "value": "   ", "description": "填入纯空格用户名"},
    {"type": "web_fill", "selector": "input[placeholder=\"密码\"]", "value": "test123", "description": "填入密码"},
    {"type": "web_click", "selector": "button.el-button--primary", "description": "点击登录按钮"},
    {"type": "web_wait", "timeout": 1, "description": "等待客户端校验响应"},
    {"type": "web_assert", "expected_text": "用户名不能为空白", "description": "验证弹窗显示用户名不能为空白"},
    {"type": "web_screenshot", "description": "纯空格用户名校验弹窗截图"}
  ]
}
