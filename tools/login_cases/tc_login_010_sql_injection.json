{
  "title": "[Web] 登录-SQL注入用户名应被安全处理",
  "url": "http://localhost:5173/login",
  "priority": "P1",
  "description": "验证SQL注入payload作为用户名时，Django ORM参数化查询防止注入，返回「用户名或密码错误」",
  "expected_result": "ElMessage 弹窗显示「用户名或密码错误」，未被注入绕过",
  "directory_id": 109,
  "steps": [
    {"type": "web_navigate", "url": "http://localhost:5173/login?add=1", "description": "打开登录页"},
    {"type": "web_wait", "timeout": 2, "description": "等待页面加载完成"},
    {"type": "web_fill", "selector": "input[placeholder=\"账号\"]", "value": "' OR '1'='1' --", "description": "填入SQL注入payload"},
    {"type": "web_fill", "selector": "input[placeholder=\"密码\"]", "value": "anything", "description": "填入任意密码"},
    {"type": "web_click", "selector": "button.el-button--primary", "description": "点击登录按钮"},
    {"type": "web_wait", "timeout": 2, "description": "等待服务器响应"},
    {"type": "web_assert", "expected_text": "用户名或密码错误", "description": "验证弹窗显示用户名或密码错误（未被注入绕过）"},
    {"type": "web_screenshot", "description": "SQL注入登录弹窗截图"}
  ]
}
