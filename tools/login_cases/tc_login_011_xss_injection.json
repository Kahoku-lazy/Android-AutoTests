{
  "title": "[Web] 登录-XSS注入用户名应被安全转义",
  "url": "http://localhost:5173/login",
  "priority": "P1",
  "description": "验证XSS payload作为用户名时，前端和后端安全处理，返回「用户名或密码错误」，脚本不执行",
  "expected_result": "ElMessage 弹窗显示「用户名或密码错误」，XSS payload 被安全处理",
  "directory_id": 109,
  "steps": [
    {"type": "web_navigate", "url": "http://localhost:5173/login?add=1", "description": "打开登录页"},
    {"type": "web_wait", "timeout": 2, "description": "等待页面加载完成"},
    {"type": "web_fill", "selector": "input[placeholder=\"账号\"]", "value": "<script>alert('xss')</script>", "description": "填入XSS payload"},
    {"type": "web_fill", "selector": "input[placeholder=\"密码\"]", "value": "test123", "description": "填入密码"},
    {"type": "web_click", "selector": "button.el-button--primary", "description": "点击登录按钮"},
    {"type": "web_wait", "timeout": 2, "description": "等待服务器响应"},
    {"type": "web_assert", "expected_text": "用户名或密码错误", "description": "验证弹窗显示用户名或密码错误（payload未执行）"},
    {"type": "web_screenshot", "description": "XSS注入登录弹窗截图"}
  ]
}
