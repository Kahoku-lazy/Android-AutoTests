{
  "title": "[Web] 登录页面跳转并登录",
  "priority": "P0",
  "url": "http://localhost:5173/login",
  "description": "导航到登录页 → 填写账号密码 → 点击登录 → 验证成功跳转到仪表盘",
  "precondition": "1. 平台服务正常运行\n2. 账号 admin/admin123 已注册",
  "expected_result": "页面跳转到仪表盘，显示'仪表盘'标题",
  "steps": [
    {
      "type": "web_navigate",
      "url": "http://localhost:5173/login",
      "description": "导航到登录页面"
    },
    {
      "type": "web_wait",
      "timeout": 2.0,
      "description": "等待 Vue 渲染完成"
    },
    {
      "type": "web_fill",
      "selector": "input[placeholder=\"账号\"]",
      "value": "admin",
      "description": "输入账号"
    },
    {
      "type": "web_fill",
      "selector": ".login-form input[type=\"password\"]",
      "value": "admin123",
      "description": "输入密码"
    },
    {
      "type": "web_click",
      "selector": ".login-form .el-button--primary",
      "description": "点击登录按钮"
    },
    {
      "type": "web_wait",
      "timeout": 3.0,
      "description": "等待登录跳转"
    },
    {
      "type": "web_assert",
      "expected_text": "仪表盘",
      "description": "验证页面跳转到仪表盘"
    }
  ]
}
