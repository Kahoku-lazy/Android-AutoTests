{
  "title": "[Web] 注册-正常注册成功跳转",
  "url": "http://localhost:5173/login?add=1",
  "priority": "P1",
  "description": "验证使用合法且不存在的用户名和密码注册，成功后显示成功提示并跳转到dashboard",
  "expected_result": "ElMessage 弹窗显示「注册成功，正在进入平台...」，页面跳转到 /dashboard",
  "directory_id": 110,
  "steps": [
    {"type": "web_navigate", "url": "http://localhost:5173/login?add=1", "description": "打开登录页"},
    {"type": "web_wait", "timeout": 2, "description": "等待页面加载"},
    {"type": "web_click", "selector": ".login-toggle", "description": "切换到注册模式"},
    {"type": "web_wait", "timeout": 1, "description": "等待表单切换"},
    {"type": "web_fill", "selector": "input[placeholder=\"设置账号（3-20 字符）\"]", "value": "autotest_u1", "description": "填入合法用户名"},
    {"type": "web_fill", "selector": "input[placeholder=\"设置密码（至少 6 位）\"]", "value": "test123456", "description": "填入合法密码"},
    {"type": "web_fill", "selector": "input[placeholder=\"确认密码\"]", "value": "test123456", "description": "填入确认密码"},
    {"type": "web_click", "selector": "button.el-button--primary", "description": "点击完成注册"},
    {"type": "web_wait", "timeout": 3, "description": "等待注册请求和跳转"},
    {"type": "web_assert", "expected_text": "仪表盘", "description": "验证跳转到dashboard页面"},
    {"type": "web_screenshot", "description": "注册成功跳转dashboard截图"}
  ]
}
